{
  "name": "everkeep",
  "version": "0.1.0",
  "description": "Modern local-first estate & life information organizer",
  "main": "./out/main/index.js",
  "author": "Everkeep",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jordanthiel/everkeep.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild --force --which-module better-sqlite3",
    "test": "npm run rebuild:node && vitest run && npm run rebuild:electron && node scripts/test-electron.mjs",
    "test:watch": "npm run rebuild:node && vitest",
    "postinstall": "npm run rebuild:electron",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:preview": "npm --prefix website run preview",
    "test:packet": "npm run build && node scripts/test-packet.mjs",
    "test:record-pages": "npm run build && node scripts/test-record-pages.mjs",
    "test:electron": "npm run rebuild:electron && node scripts/test-electron.mjs",
    "sharing:build": "npm run website:build",
    "sharing:dev": "supabase functions serve sharing --env-file supabase/.env.local",
    "test:sharing": "npm run build && npm run sharing:build && node scripts/test-sharing.mjs",
    "test:sharing:postgres": "node scripts/test-sharing-postgres.mjs",
    "test:sharing:supabase": "node scripts/supabase-local-smoke.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "12.4.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "3.6.1",
    "@eslint/js": "^9.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.1",
    "postgres": "^3.4.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.everkeep.app",
    "productName": "Everkeep",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Everkeep",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Everkeep-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Everkeep",
      "uninstallDisplayName": "Everkeep",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "publish": {
      "provider": "github",
      "owner": "jordanthiel",
      "repo": "everkeep"
    },
    "fileAssociations": [
      {
        "ext": "everkeep-backup",
        "name": "Everkeep Backup",
        "description": "Everkeep vault backup",
        "role": "Viewer",
        "rank": "Owner"
      }
    ],
    "protocols": [
      {
        "name": "Everkeep shared vault",
        "schemes": [
          "everkeep"
        ]
      }
    ]
  }
}
