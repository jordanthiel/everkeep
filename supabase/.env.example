# Copy to supabase/.env.local for local development. Keep real keys out of Git.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL
# are supplied by the Edge Function runtime. Never put the service key in a client build.
SHARING_PUBLIC_URL=https://your-existing-website.example/share
SHARING_FROM_EMAIL=Everkeep <your-existing-verified-sender@example.com>
RESEND_API_KEY=replace-with-your-existing-resend-key
SHARING_DATA_KEY=replace-with-32-random-bytes-encoded-as-base64
SHARING_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: the project's transaction-mode pooler connection string.
# SHARING_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
